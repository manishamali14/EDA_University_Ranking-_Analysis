e extra spaces from text columns\n","for column in times.select_dtypes(include=\"object\").columns:\n","    times[column] = times[column].str.strip()\n","\n","for column in cwur.select_dtypes(include=\"object\").columns:\n","    cwur[column] = cwur[column].str.strip()\n","\n","for column in shanghai.select_dtypes(include=\"object\").columns:\n","    shanghai[column] = shanghai[column].str.strip()\n","\n","for column in school_country.select_dtypes(include=\"object\").columns:\n","    school_country[column] = school_country[column].str.strip()\n","\n","for column in education_expenditure.select_dtypes(include=\"object\").columns:\n","    education_expenditure[column] = education_expenditure[column].str.strip()\n","\n","for column in educational_attainment.select_dtypes(include=\"object\").columns:\n","    educational_attainment[column] = educational_attainment[column].str.strip()\n","\n","# Standardise country names\n","country_mapping = {\n","    \"USA\": \"United States of America\",\n","    \"United States\": \"United States of America\",\n","    \"Unisted States of America\": \"United States of America\",\n","    \"United States of America\": \"United States of America\",\n","    \"Russia\": \"Russian Federation\",\n","    \"Russian Federation\": \"Russian Federation\",\n","    \"Ireland\": \"Republic of Ireland\",\n","    \"Republic of Ireland\": \"Republic of Ireland\",\n","    \"Slovak Republic\": \"Slovakia\",\n","    \"Slovakia\": \"Slovakia\",\n","    \"South Korea\": \"South Korea\",\n","    \"Korea, Rep.\": \"South Korea\",\n","    \"Korea, Republic of\": \"South Korea\",\n","    \"Unted Kingdom\": \"United Kingdom\",\n","    \"United Kingdom\": \"United Kingdom\"\n","}\n","times[\"country\"] = times[\"country\"].replace(country_mapping)\n","cwur[\"country\"] = cwur[\"country\"].replace(country_mapping)\n","school_country[\"country\"] = school_country[\"country\"].replace(country_mapping)\n","education_expenditure[\"country\"] = (education_expenditure[\"c