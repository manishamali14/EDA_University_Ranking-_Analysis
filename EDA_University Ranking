     \"num_students\", \"student_staff_ratio\", \"international_students\",\n","              \"female_percentage\", \"male_percentage\"]\n","times[times_cols] = times[times_cols].apply(pd.to_numeric, errors=\"coerce\")\n","\n","for col in [\"num_students\", \"student_staff_ratio\", \"international_students\"]:\n","    times[col] = times[col].fillna(times.groupby(\"year\")[col].transform(\"median\"))\n","\n","# shanghai - one row has no university name\n","shanghai = shanghai.dropna(subset=[\"university_name\"])\n","for col in [\"alumni\", \"award\", \"hici\", \"ns\", \"pub\", \"pcp\"]:\n","    shanghai[col] = shanghai[col].fillna(shanghai.groupby(\"year\")[col].transform(\"median\"))\n","\n","# educational attainment \n","educational_attainment = educational_attainment[educational_attainment[\"series_name\"].notna()].copy()\n","years = [col for col in educational_attainment.columns if col.isdigit()]\n","educational_attainment[years] = educational_attainment[years].apply(pd.to_numeric, errors=\"coerce\")\n","educational_attainment = educational_attainment.dropna(axis=1, how=\"all\")\n","\n","print(times.isnull().sum(), cwur.isnull().sum(), shanghai.isnull().sum(), sep=\"\\n\\n\")\n","\n","times_2015 = times[times[\"year\"] == 2015]\n","cwur_2015 = cwur[cwur[\"year\"] == 2015]\n","shanghai_2015 = shanghai[shanghai[\"year\"] == 2015]\n","\n","print(\"Times 2015:\", times_2015.shape)\n","print(\"CWUR 2015:\", cwur_2015.shape)\n","print(\"Shanghai 2015:\", shanghai_2015.shape)"]},{"cell_type":"markdown","id":"2d3089d6","metadata":{"papermill":{"duration":0.004023,"end_time":"2026-11-21T20:13:23.691186+00:00","exception":false,"start_time":"2026-11-21T20:13:23.687163+00:00","status":"completed"},"tags":[]},"source":["*The datasets required cleaning of duplicate records, missing values, inconsistent country names, ranking formats, and incorrect data types. Total score is only published for the top ~200 Times and top 100 Shanghai universities, so it was left missing for th